{
  "name": "ha-js-automations",
  "version": "2.57.9",
  "description": "",
  "main": "js_automations/server.js",
  "scripts": {
    "start": "node js_automations/server.js",
    "dev": "nodemon js_automations/server.js",
    "version": "node tools/update-version.js",
    "release": "node tools/release.js",
    "ship:patch": "npm version patch && npm run release",
    "ship:minor": "npm version minor && npm run release",
    "ship:major": "npm version major && npm run release",
    "ship:beta": "npm version prerelease --preid=beta && npm run release",
    "ship:beta:minor": "npm version preminor --preid=beta && npm run release",
    "ship:beta:major": "npm version premajor --preid=beta && npm run release",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit -p js_automations/public/tsconfig.json",
    "build": "esbuild js_automations/public/js/components/index.ts --bundle --format=esm --outfile=js_automations/public/js/dist/components.js",
    "test": "node --test \"test/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "archiver": "^8.0.0",
    "blockly": "^11.2.2",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "home-assistant-js-websocket": "^9.6.0",
    "i18next": "^26.3.2",
    "i18next-http-backend": "^4.0.0",
    "lit": "^3.3.3",
    "mqtt": "^5.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.3",
    "typescript": "^6.0.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.6"
  }
}
