{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "js_automations/server.js",
    "js_automations/core/**/*.js",
    "js_automations/routes/**/*.js",
    "js_automations/services/**/*.js",
    "tools/**/*.js"
  ],
  "exclude": ["node_modules", "scripts", "js_automations_beta", "js_automations/public", "examples"]
}
